<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. ScrollView с основным контентом, теперь внутри FrameLayout -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top"
            android:padding="16dp"> <!-- Padding перенесен сюда -->

            <TextView
                android:id="@+id/labelEmotions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Как вы себя чувствуете?"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/moodSelectedRecyclerView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/labelTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настроение вкратце"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/tagEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Норм, не очень, отлично..."
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:background="@drawable/rounded_edittext" />


            <TextView
                android:id="@+id/labelDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Опишитие ваши эмоции"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/descriptionEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Что у вас на душе?"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top|start"
                android:background="@drawable/rounded_edittext" />

            <TextView
                android:id="@+id/labelData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Дата, время"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/dateEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Дата"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:background="@drawable/rounded_edittext"
                android:drawableEnd="@android:drawable/ic_menu_today"
                android:padding="12dp"
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/timeEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Время"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:background="@drawable/rounded_edittext"
                android:drawableEnd="@android:drawable/ic_lock_idle_alarm"
                android:padding="12dp"
                android:textSize="16sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="24dp"
                android:text="Сохранить"
                app:cornerRadius="26dp"
                style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>
    </ScrollView>

    <!-- 2. ProgressBar, расположенный по центру, поверх всего контента -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible" />

</FrameLayout>