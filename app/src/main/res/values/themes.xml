<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Mood_diary" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="searchViewStyle">@style/NoSearchIconSearchView</item>
    </style>

    <style name="Theme.Mood_diary" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
    </style>

    <style name="FabShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CustomToolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="tint">@android:color/white</item>

    </style>


    <style name="AppTheme.SearchView" parent="">
        <item name="android:textColorPrimary">@android:color/white</item>

        <item name="android:textColorHint">#7A7F80</item>

        <item name="colorControlNormal">@android:color/white</item>
    </style>

    <style name="NoSearchIconSearchView" parent="Widget.AppCompat.SearchView">
        <item name="searchHintIcon">@null</item>

        <item name="queryBackground">@android:color/transparent</item>
    </style>

</resources>